# Copy to .env.local only after you create and configure your own Firebase Web app.
# These placeholders are deliberately non-functional; no live project or API key is included.
# Optional local Chrome demo: use the exact fictional values below. The app then
# forces the Firebase AI SDK to ONLY_ON_DEVICE and rejects cloud fallback.
VITE_FIELD_FIX_LOCAL_DEMO=false
# VITE_FIELD_FIX_LOCAL_DEMO=true
# VITE_FIREBASE_API_KEY=fieldfix-local-demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=fieldfix-local-demo.invalid
# VITE_FIREBASE_PROJECT_ID=fieldfix-local-demo
# VITE_FIREBASE_APP_ID=fieldfix-local-demo-app-id
# VITE_RECAPTCHA_V3_SITE_KEY=fieldfix-local-demo-recaptcha-site-key

VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-your-firebase-web-app-id
VITE_RECAPTCHA_V3_SITE_KEY=replace-with-your-app-check-recaptcha-v3-site-key

# Development only: set true to use the App Check debug provider on localhost.
# Never enable this in a public/production build. Never paste a debug token into a committed file.
VITE_APPCHECK_DEBUG_TOKEN=false
